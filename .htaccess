# Send www.beprojectlab.com to beprojectlab.com so Google sees a single site.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.beprojectlab\.com$ [NC]
RewriteRule ^(.*)$ https://beprojectlab.com/$1 [R=301,L]
</IfModule>

# TEMPORARY (since 20 Oct 2026): every address shows only "Próximamente / Coming soon"
# (proximamente.html), and search engines are asked not to index it.
# Exception: the administration panel (/admin/, /en/admin/) and the files it uses.
# The rest of the site stays in the repository untouched.
# To bring the site back: delete from here to "END TEMPORARY", push, and empty the CDN cache.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/proximamente\.html$
RewriteCond %{REQUEST_URI} !^/google2c498b7b1752ce5f\.html$
# The administration panel stays reachable (it needs its styles and scripts).
RewriteCond %{REQUEST_URI} !^/(en/)?admin(/|$)
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/(favicon|apple-touch-icon)
RewriteRule ^ /proximamente.html [L]
</IfModule>
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex"
</IfModule>
# END TEMPORARY

# The supabase/ folder holds database changes for Supabase; it is not part of the website.
RedirectMatch 404 ^/supabase(/|$)

# Pages: browsers must check for a newer version every time, so changes show up
# without clearing the cache. Styles and scripts carry a ?v= number instead.
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
