# Send www.beprojectlab.com to beprojectlab.com so Google sees a single site.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.beprojectlab\.com$ [NC]
RewriteRule ^(.*)$ https://beprojectlab.com/$1 [R=301,L]
</IfModule>

# The supabase/ folder holds database changes for Supabase; it is not part of the website.
RedirectMatch 404 ^/supabase(/|$)

# Pages: browsers must check for a newer version every time, so changes show up
# without clearing the cache. Styles and scripts carry a ?v= number instead.
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
